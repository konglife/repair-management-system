# ─────────────────────────────────────────────────────────────
# Environment variables template.
#   1. Copy this file to .env.local:  cp .env.example .env.local
#   2. Fill in real values (NEVER commit .env.local).
#
# .env.example is committed to the repo (no secrets).
# .env.local is gitignored and is the only env file used by `npm run dev` / `npm test`.
#
# Local dev/test connects to the DEV database only.
# Vercel is the source of truth for real values (vercel env pull).
# ─────────────────────────────────────────────────────────────

# ── Database (Prisma Postgres on Vercel — use the DEV connection strings locally) ──
DATABASE_URL=
PRISMA_DATABASE_URL=
DIRECT_URL=
POSTGRES_URL=

# ── Clerk (authentication) ──
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ── Clerk redirect URLs ──
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=
